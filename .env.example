# ============================================================================
#  Colégio Genil — matérias a partir do grupo de WhatsApp
#  Copie para .env e preencha. Nunca comite o .env.
# ============================================================================

# --- WhatsApp ---------------------------------------------------------------
# JID do grupo monitorado. Rode `npm run pareia` para descobrir.
WHATSAPP_GRUPO_JID=

# Opcional: só estes números podem pautar (E.164 sem +, separados por vírgula).
# Vazio = qualquer participante do grupo.
WHATSAPP_AUTORES=

# Opcional: só vira matéria a mensagem que contiver esta palavra.
# Útil se o grupo também é usado para recado do dia a dia. Ex: #materia
WHATSAPP_GATILHO=

# --- Agrupamento ------------------------------------------------------------
# Mensagens do mesmo professor dentro desta janela formam UMA matéria.
PAUTA_JANELA_MINUTOS=10
PAUTA_MINIMO_CARACTERES=40
PAUTA_MAX_FOTOS=12

# --- Redação ----------------------------------------------------------------
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
NOME_COLEGIO=Colégio Genil
# O tom das matérias se ajusta aqui, sem mexer em código:
MANUAL_REDACAO=./editorial/manual.md

# --- Publicação -------------------------------------------------------------
# wordpress | markdown | nenhum
PUBLICADOR=nenhum

# true  = entra como rascunho no site, alguém publica lá  (recomendado)
# false = vai direto ao ar quando aprovado no painel
PUBLICAR_COMO_RASCUNHO=true

# -- se PUBLICADOR=wordpress --
WP_URL=https://www.colegiogenil.com.br
WP_USUARIO=
# WordPress → Usuários → seu perfil → Application Passwords
WP_SENHA_APP=
WP_CATEGORIA_ID=
WP_AUTOR_ID=

# -- se PUBLICADOR=markdown --
MD_PASTA=./saida/materias
MD_PASTA_IMAGENS=./saida/materias/imagens

# --- Painel de aprovação ----------------------------------------------------
PORTA=3000
PAINEL_USUARIO=genil
# Obrigatória. Gere uma forte: openssl rand -base64 24
PAINEL_SENHA=
# URL pública do painel, usada no link que o robô manda no grupo.
PAINEL_URL=
AVISAR_NO_GRUPO=true

# --- Fotos ------------------------------------------------------------------
FOTO_LARGURA_MAX=1600
FOTO_LARGURA_THUMB=480
FOTO_QUALIDADE=82

LOG_NIVEL=info
